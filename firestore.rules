rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function hasActiveAccess(userId) {
      return exists(/databases/$(database)/documents/access/$(userId))
        && get(/databases/$(database)/documents/access/$(userId)).data.status == 'active'
        && (!(get(/databases/$(database)/documents/access/$(userId)).data.expiresAt is timestamp)
          || get(/databases/$(database)/documents/access/$(userId)).data.expiresAt > request.time);
    }

    function validPresence(userId) {
      return request.resource.data.uid == userId
        && request.resource.data.online is bool
        && request.resource.data.lastSeen == request.time
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 2048;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if isAdmin() || (isSelf(userId) && hasActiveAccess(userId));
    }

    match /access/{userId} {
      allow read: if isAdmin() || isSelf(userId);
      allow write: if false;
    }

    match /presence/{userId} {
      allow read: if isAdmin() || isSelf(userId);
      allow create: if isSelf(userId)
        && validPresence(userId)
        && request.resource.data.keys().hasOnly(['uid', 'online', 'lastSeen', 'displayName', 'email', 'photoURL']);
      allow update: if isSelf(userId)
        && validPresence(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['online', 'lastSeen', 'displayName', 'email', 'photoURL']);
      allow delete: if isSelf(userId);
    }

    match /admins/{adminId} {
      allow read: if isAdmin() || isSelf(adminId);
      allow write: if false;
    }

    match /adminAudit/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /adminNotes/{userId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
